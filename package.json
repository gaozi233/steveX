{
  "name": "stevex",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "dsh": "dsh",
    "test": "node --test test/nbt/nbt_reader.test.js test/nbt/query.test.js test/nbt/loader.test.js test/nbt/api.test.js dsh-plugins/router/test/domain_slots.test.js dsh-plugins/router/test/domain_router.test.js dsh-plugins/router/test/domain_turn_scope.test.js dsh-plugins/router/test/plugin.test.js",
    "bootstrap": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap.ps1",
    "mc:capture": "powershell -ExecutionPolicy Bypass -File scripts/run-capture.ps1",
    "mc:memory": "powershell -ExecutionPolicy Bypass -File scripts/run-memory.ps1",
    "render:bridge": "node src/render_bridge/main.js",
    "render:client": "powershell -ExecutionPolicy Bypass -File scripts/run-renderer.ps1",
    "test:render": "node --test test/render_bridge/*.test.js",
    "start:all": "powershell -ExecutionPolicy Bypass -File scripts/start-all.ps1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mineflayer": "^4.39.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2"
  }
}
